<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{{ site.name }}{% endblock %} &mdash; {{ site.masthead }}</title>
<meta name="description" content="{% block description %}{{ site.tagline }}{% endblock %}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=STIX+Two+Text:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/static/css/style.css">
</head>
<body class="{% block bodyclass %}{% endblock %}">

<header class="masthead">
  <div class="masthead-row">
    <a class="masthead-name" href="/index.html">{{ site.name }}</a>
    <span class="masthead-journal">{{ site.masthead }} &middot; VOL. {{ site.issue_year }}</span>
  </div>
  <nav class="nav-bar" aria-label="Primary">
    <button class="nav-toggle" id="navToggle" aria-expanded="false" aria-controls="navList">Menu</button>
    <ul class="nav-list" id="navList">
      {% for item in site.nav %}
      <li><a href="{{ item.href }}"{% if item.label == active_nav %} class="is-active" aria-current="page"{% endif %}>{{ item.label }}</a></li>
      {% endfor %}
    </ul>
  </nav>
</header>

<main id="main">
{% block content %}{% endblock %}
</main>

<footer class="site-footer">
  <div class="footer-rule"></div>
  <div class="footer-grid">
    <div class="footer-col">
      <p class="footer-label">References</p>
      <ul class="footer-refs">
        <li><a href="/cv.html">[1] Curriculum Vitae &mdash; full record</a></li>
        <li><a href="/work/index.html">[2] Selected Work &mdash; project index</a></li>
        <li><a href="/about.html">[3] About &mdash; background &amp; focus</a></li>
      </ul>
    </div>
    <div class="footer-col footer-meta">
      <p class="footer-label">Manuscript info</p>
      <p class="mono-small">{{ site.domain }}</p>
      <p class="mono-small">Maintained continuously since {{ site.issue_year }}</p>
      <p class="mono-small">&copy; {{ site.issue_year }} {{ site.name }}</p>
    </div>
  </div>
</footer>

<script src="/static/js/main.js"></script>
</body>
</html>
