{% extends "base.html.j2" %}
{% block title %}{{ site.name }}{% endblock %}
{% block description %}{{ site.tagline }}{% endblock %}
{% block bodyclass %}page-home{% endblock %}

{% block content %}
<article class="paper">

  <div class="byline">
    <h1 class="doc-title">{{ site.name }}</h1>
    <p class="doc-subtitle">{{ site.tagline }}</p>
    <p class="mono-small doc-meta">Independent engineering practice &middot; Nepal</p>
  </div>

  <div class="abstract-block">
    <p><span class="abstract-label">Abstract&mdash;</span>{{ profile.abstract }}</p>
    <p class="index-terms"><span class="abstract-label">Index Terms&mdash;</span><em>{{ profile.index_terms | join(', ') }}</em></p>
  </div>

  <section class="paper-section">
    <h2 class="section-heading"><span class="section-num">I.</span> Overview</h2>
    <div class="article-grid">
      <p>{{ profile.sections.overview }}</p>
    </div>
  </section>

  <section class="paper-section">
    <h2 class="section-heading"><span class="section-num">II.</span> Technical Focus</h2>
    <div class="article-grid">
      <p>{{ profile.sections.technical_focus }}</p>
    </div>
  </section>

  <section class="paper-section">
    <h2 class="section-heading"><span class="section-num">III.</span> Current Work</h2>
    <div class="article-grid">
      <p>{{ profile.sections.current_work }}</p>
    </div>
  </section>

  <section class="paper-section">
    <h2 class="section-heading"><span class="section-num">IV.</span> {{ profile.cta.heading }}</h2>
    <p class="section-note">{{ profile.cta.note }}</p>
    <ul class="work-list">
      {% for p in projects %}
      <li class="work-row">
        <a class="work-row-title" href="/work/{{ p.slug }}.html">{{ p.title }}</a>
        <span class="tier-tag tier-{{ p.tier | lower }}">Tier {{ p.tier }}</span>
        <span class="mono-small work-row-status">{{ p.status_label }}</span>
        <p class="work-row-sub">{{ p.subtitle }}</p>
      </li>
      {% endfor %}
    </ul>
    <p class="see-all"><a href="/work/index.html">See full work index &rarr;</a></p>
  </section>

  <section class="paper-section">
    <h2 class="section-heading"><span class="section-num">V.</span> Leadership &amp; Recognition</h2>
    <div class="article-grid">
      <p>{{ profile.sections.leadership }}</p>
    </div>
  </section>

</article>
{% endblock %}
