{% extends "base.html.j2" %}

{% block content %}

<article class="paper">

    <header class="paper-header">

        <div class="paper-kicker">
            {{ research.type }}
            · {{ research.version }}
            · {{ research.date }}
        </div>

        <h1>{{ research.title }}</h1>

        <p class="paper-subtitle">
            {{ research.subtitle }}
        </p>

        <div class="paper-meta">

            <div>
                <span>AUTHOR</span>
                {{ research.authors | join(", ") }}
            </div>

            <div>
                <span>STATUS</span>
                {{ research.status }}
            </div>

            <div>
                <span>DOMAIN</span>
                {{ research.domains | join(" · ") }}
            </div>

        </div>

    </header>


    <section>

        <h2>Abstract</h2>

        <p>
            {{ research.summary }}
        </p>

    </section>


    <section>

        <h2>Research Question</h2>

        <p>
            {{ research.research_question }}
        </p>

    </section>


    <section>

        <h2>Analytical Model</h2>

        <div class="equation">
            {{ research.model.equation }}
        </div>

        <p>
            {{ research.model.description }}
        </p>

    </section>


    <section>

        <h2>Computational Experiments</h2>

        <ul>
            {% for experiment in research.experiments %}
                <li>{{ experiment }}</li>
            {% endfor %}
        </ul>

    </section>


    <section>

        <h2>Baseline Result</h2>

        <table>

            <tr>
                <th>Optimal hop count</th>
                <td>{{ research.baseline.optimal_hops }}</td>
            </tr>

            <tr>
                <th>Minimum energy</th>
                <td>{{ research.baseline.minimum_energy_j }} J</td>
            </tr>

        </table>

    </section>


    {% if research.figures %}

    <section>

        <h2>Results</h2>

        {% for figure in research.figures %}

        <figure>

            <img
                src="/{{ figure.file }}"
                alt="{{ figure.title }}"
                loading="lazy"
            >

            <figcaption>
                {{ figure.caption }}
            </figcaption>

        </figure>

        {% endfor %}

    </section>

    {% endif %}


    <section>

        <h2>Limitations</h2>

        <ul>
            {% for limitation in research.limitations %}
                <li>{{ limitation }}</li>
            {% endfor %}
        </ul>

    </section>


    <section>

        <h2>Future Work</h2>

        <ul>
            {% for item in research.future_work %}
                <li>{{ item }}</li>
            {% endfor %}
        </ul>

    </section>


    <section>

        <h2>Reproducibility</h2>

        <div class="paper-links">

            <a href="{{ research.links.github }}" target="_blank">
                GitHub Repository ↗
            </a>

            <a href="{{ research.links.latex }}" target="_blank">
                LaTeX Source ↗
            </a>

            <a href="{{ research.links.pdf }}" target="_blank">
                PDF ↗
            </a>

            <a href="{{ research.links.results }}" target="_blank">
                Results ↗
            </a>

        </div>

    </section>

</article>

{% endblock %}