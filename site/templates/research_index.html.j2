{% extends "base.html.j2" %}

{% block content %}

<header class="section-header">

    <div class="section-kicker">
        RESEARCH ARCHIVE
    </div>

    <h1>Research</h1>

    <p>
        Experimental work, analytical studies, computational models,
        and research notes.
    </p>

</header>


<div class="archive-list">

{% for research in research_items %}

<article class="archive-entry">

    <div class="archive-entry-header">

        <div>

            <div class="archive-kicker">
                {{ research.type }}
                · {{ research.version }}
            </div>

            <h2>
                <a href="/research/{{ research.slug }}/">
                    {{ research.title }}
                </a>
            </h2>

            <p>
                {{ research.subtitle }}
            </p>

        </div>

        <time>
            {{ research.date }}
        </time>

    </div>


    <div class="archive-meta">

        <span>{{ research.status }}</span>

        {% for domain in research.domains %}
            <span>{{ domain }}</span>
        {% endfor %}

    </div>

</article>

{% endfor %}

</div>

{% endblock %}